---
import { Image } from 'astro:assets';
import { brand } from '@/data/images';
import { site, nav, hoursSummary, reserveHref, formattedAddress } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="seam seam-top"></div>

  <div class="shell site-footer__grid">
    <div class="site-footer__brand">
      <Image
        src={brand.logoCream}
        alt={site.name}
        widths={[250, 400, 532]}
        sizes="(max-width: 767px) 200px, 250px"
        loading="lazy"
        class="site-footer__logo"
      />
      <address class="site-footer__address">
        {site.address.street}<br />
        {site.address.locality}, {site.address.region} {site.address.postalCode}<br />
        <a class="link" href={site.phone.href}>{site.phone.display}</a>
      </address>
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-label="Footer">
        <h2 class="site-footer__head">Explore</h2>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a class="link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__head">Hours</h2>
        <ul>
          {
            hoursSummary.map((h) => (
              <li class:list={['site-footer__hours', h.closed && 'is-closed']}>
                {h.label} · {h.value}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__head">Follow</h2>
        <ul>
          {
            site.social.map((s) =>
              s.href ? (
                <li>
                  <a class="link" href={s.href} rel="me noopener" target="_blank">
                    {s.label}
                  </a>
                </li>
              ) : (
                <li class="site-footer__pending">{s.label}</li>
              ),
            )
          }
        </ul>
        {
          site.social.every((s) => !s.href) && (
            <p class="site-footer__note t-mono">Handles to confirm</p>
          )
        }
      </div>
    </div>

    <div class="site-footer__cta">
      <p class="site-footer__cta-title">Join us<br />this evening</p>
      <a href={reserveHref} class="btn btn-primary site-footer__cta-btn">Reserve a Table</a>
    </div>
  </div>

  <div class="shell site-footer__base">
    <p class="t-mono site-footer__fine">
      © {year}
      {site.name} · {site.address.locality}, {site.address.region}
    </p>
    <div class="site-footer__mark">
      <Image
        src={brand.grouchGold}
        alt=""
        widths={[52, 104]}
        sizes="52px"
        loading="lazy"
        class="site-footer__grouch"
      />
      <span class="t-mono site-footer__fine">Est. {site.established}</span>
    </div>
  </div>

  <span class="sr-only">{formattedAddress}</span>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-black);
    padding-block: 60px 34px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-block: 110px 46px;
    }
  }

  .site-footer__grid {
    display: grid;
    gap: 48px;
    padding-bottom: 44px;
    border-bottom: 1px solid rgb(180 134 58 / 0.14);
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: minmax(240px, 340px) 1fr;
      gap: 60px;
      padding-bottom: 64px;
    }
  }

  @media (min-width: 1280px) {
    .site-footer__grid {
      grid-template-columns: 340px 1fr auto;
      align-items: start;
    }
  }

  .site-footer__logo {
    width: 200px;
    height: auto;
  }

  @media (min-width: 768px) {
    .site-footer__logo {
      width: 250px;
    }
  }

  .site-footer__address {
    font-style: normal;
    font-size: var(--fs-body-sm);
    line-height: 1.8;
    color: var(--color-muted);
    margin-top: 24px;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 36px 40px;
  }

  @media (min-width: 1280px) {
    .site-footer__cols {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 80px;
    }
  }

  .site-footer__head {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
    margin: 0 0 20px;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: var(--fs-body-sm);
    color: var(--color-warm-grey);
  }

  .site-footer__col a {
    display: inline-block;
    padding-block: 2px;
  }

  /*
    A stacked list of links needs its targets separated, not just enlarged — an
    invisible overlay here would overlap its neighbours and steal taps. So on
    touch the padding does the work and the gap tightens to keep the column's
    overall rhythm close to the handoff.
  */
  @media (pointer: coarse), (max-width: 767px) {
    .site-footer__col ul {
      gap: 4px;
    }
    .site-footer__col a {
      padding-block: 10px;
    }
  }

  .site-footer__hours.is-closed {
    color: rgb(184 178 167 / 0.45);
  }

  .site-footer__pending {
    color: var(--color-warm-grey);
  }

  .site-footer__note {
    color: rgb(184 178 167 / 0.4);
    margin-top: 12px;
    font-size: 10.5px;
    letter-spacing: 0.2em;
  }

  .site-footer__cta {
    border: 1px solid rgb(180 134 58 / 0.3);
    padding: 34px 38px;
    text-align: center;
    justify-self: start;
  }

  @media (min-width: 1280px) {
    .site-footer__cta {
      justify-self: end;
    }
  }

  .site-footer__cta-title {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.25;
    color: var(--color-cream);
  }

  .site-footer__cta-btn {
    margin-top: 24px;
    --btn-py: 15px;
    --btn-px: 28px;
    min-height: 0;
    font-size: 12px;
  }

  .site-footer__base {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: center;
    text-align: center;
    padding-top: 30px;
  }

  @media (min-width: 768px) {
    .site-footer__base {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .site-footer__fine {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: rgb(184 178 167 / 0.42);
  }

  .site-footer__mark {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-footer__grouch {
    width: 52px;
    height: auto;
    opacity: 0.6;
  }
</style>
