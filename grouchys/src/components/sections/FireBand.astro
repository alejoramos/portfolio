---
import Frame from '@/components/Frame.astro';
import { photo } from '@/data/images';

const embers = [
  { left: '30%', bottom: '90px', size: 3, color: 'var(--color-ember)', dur: '7s', delay: '0s' },
  { left: '44%', bottom: '70px', size: 2, color: 'var(--color-gold)', dur: '9s', delay: '.9s' },
  { left: '58%', bottom: '110px', size: 3, color: 'var(--color-ember)', dur: '8s', delay: '2.4s' },
  { left: '68%', bottom: '82px', size: 2, color: 'var(--color-gold-light)', dur: '10s', delay: '4s' },
];
---

<section class="fire grain" aria-labelledby="fire-title">
  <div class="fire__photo" aria-hidden="true">
    <Frame
      src={photo.grill}
      alt=""
      widths={[640, 1000, 1400]}
      sizes="100vw"
      position="50% 58%"
      class="fire__frame"
    />
  </div>

  <div class="fire__veil" aria-hidden="true"></div>
  <div class="fire__glow" aria-hidden="true"></div>

  {
    embers.map((e) => (
      <span
        class="ember"
        aria-hidden="true"
        style={`left:${e.left};bottom:${e.bottom};width:${e.size}px;height:${e.size}px;background:${e.color};animation-duration:${e.dur};animation-delay:${e.delay}`}
      />
    ))
  }

  <div class="shell fire__inner">
    <p class="eyebrow eyebrow-center fire__eyebrow" data-reveal>Charcoal · Oak · Open flame</p>
    <h2 class="t-fire fire__title" id="fire-title" data-fire-sweep>
      <span class="fire__title-text">Crafted over fire.</span>
    </h2>
    <p class="t-body fire__lead" data-reveal>
      Everything worth charring goes over live flame — cuts seasoned simply, cooked hard, rested
      properly.
    </p>
  </div>
</section>

<style>
  .fire {
    position: relative;
    overflow: hidden;
    background: var(--color-black-3);
    border-top: 1px solid rgb(180 134 58 / 0.14);
    border-bottom: 1px solid rgb(180 134 58 / 0.14);
    min-height: 340px;
    display: flex;
    align-items: center;
    padding-block: 64px;
  }

  @media (min-width: 768px) {
    .fire {
      min-height: 440px;
    }
  }

  @media (min-width: 1280px) {
    .fire {
      height: 520px;
      min-height: 520px;
      padding-block: 0;
    }
  }

  .fire__photo {
    position: absolute;
    inset: 0;
    opacity: 0.42;
  }

  .fire__photo :global(.frame) {
    position: absolute;
    inset: 0;
  }

  .fire__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #0b0908 0%,
      rgb(11 9 8 / 0.45) 40%,
      rgb(11 9 8 / 0.75) 78%,
      #0b0908 100%
    );
    pointer-events: none;
  }

  .fire__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(55% 120% at 50% 116%, rgb(214 110 30 / 0.34), rgb(11 9 8 / 0) 66%);
    pointer-events: none;
  }

  .fire__inner {
    position: relative;
    text-align: center;
    z-index: 2;
  }

  .fire__eyebrow {
    letter-spacing: 0.3em;
  }

  @media (min-width: 768px) {
    .fire__eyebrow {
      letter-spacing: 0.36em;
    }
  }

  .fire__title {
    margin-top: 18px;
  }

  @media (min-width: 768px) {
    .fire__title {
      margin-top: 24px;
    }
  }

  /*
    A warm light sweeps once across the display line on entry. It rides on the
    text itself via background-clip, so nothing overlays the type and the plain
    cream colour stays as the resting state.
  */
  .fire__title-text {
    display: inline-block;
    background-image: linear-gradient(
      100deg,
      var(--color-cream) 0%,
      var(--color-cream) 38%,
      #ffe4b8 50%,
      var(--color-cream) 62%,
      var(--color-cream) 100%
    );
    background-size: 280% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--color-cream);
  }

  .fire__title[data-swept] .fire__title-text {
    color: transparent;
    animation: fireSweep 1400ms var(--ease-reveal) forwards;
  }

  @keyframes fireSweep {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fire__title[data-swept] .fire__title-text {
      color: var(--color-cream);
      animation: none;
    }
  }

  .fire__lead {
    max-width: 560px;
    margin-inline: auto;
    margin-top: 20px;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .fire__lead {
      margin-top: 28px;
    }
  }

  /* The 430 frame carries the display line only. */
  @media (max-width: 767px) {
    .fire__lead {
      display: none;
    }
  }
</style>
