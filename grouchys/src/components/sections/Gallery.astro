---
import { getImage } from 'astro:assets';
import Frame from '@/components/Frame.astro';
import { gallery, galleryMobile } from '@/data/gallery';

interface Props {
  /** Homepage renders the header; the gallery page supplies its own. */
  withHeader?: boolean;
  headingId?: string;
}

const { withHeader = true, headingId = 'gallery-title' } = Astro.props;

/** A larger encode for the lightbox, generated at build time. */
async function withFull<T extends { image: ImageMetadata }>(cells: T[]) {
  return Promise.all(
    cells.map(async (cell) => ({
      ...cell,
      full: (await getImage({ src: cell.image, format: 'webp', width: 1600, quality: 78 })).src,
    })),
  );
}

import type { ImageMetadata } from 'astro';

const desktopCells = await withFull(gallery);
const mobileCells = await withFull(galleryMobile);
---

<section class="section band-b gallery" aria-labelledby={headingId}>
  <div class="shell">
    {
      withHeader && (
        <header class="gallery__head">
          <div>
            <p class="eyebrow" data-reveal>
              The room
            </p>
            <h2 class="t-h2 gallery__title" id={headingId} data-reveal>
              Warm light,
              <br />
              low conversation.
            </h2>
          </div>
          <p class="gallery__lead" data-reveal>
            Dark wood, deep booths and pendant light. Comfortable enough for a Tuesday, right for an
            anniversary.
          </p>
        </header>
      )
    }

    <ul class="gallery__grid gallery__grid--desktop" data-gallery>
      {
        desktopCells.map((cell, i) => (
          <li
            class="gallery__cell"
            style={`--col:${cell.col};--row:${cell.row}`}
            data-depth={cell.depth}
          >
            <button
              type="button"
              class="gallery__trigger"
              data-lightbox
              data-full={cell.full}
              data-caption={cell.alt}
              data-index={i}
            >
              <span class="sr-only">Open image: {cell.alt}</span>
              <Frame
                src={cell.image}
                alt=""
                widths={[420, 640, 900, 1400]}
                sizes="(max-width: 1279px) 45vw, 30vw"
                class="gallery__photo"
              />
            </button>
          </li>
        ))
      }
    </ul>

    <ul class="gallery__grid gallery__grid--mobile" data-gallery>
      {
        mobileCells.map((cell, i) => (
          <li class:list={['gallery__cell', cell.tall && 'is-tall']} data-depth="0">
            <button
              type="button"
              class="gallery__trigger"
              data-lightbox
              data-full={cell.full}
              data-caption={cell.alt}
              data-index={i}
            >
              <span class="sr-only">Open image: {cell.alt}</span>
              <Frame
                src={cell.image}
                alt=""
                widths={[300, 480, 640]}
                sizes="46vw"
                class="gallery__photo"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 26px;
  }

  @media (min-width: 1024px) {
    .gallery__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 60px;
      margin-bottom: 60px;
    }
  }

  .gallery__title {
    margin-top: 16px;
  }

  @media (min-width: 768px) {
    .gallery__title {
      margin-top: 26px;
    }
  }

  .gallery__lead {
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--color-warm-grey);
    max-width: 360px;
  }

  @media (max-width: 1023px) {
    .gallery__lead {
      max-width: 46ch;
    }
  }

  /* ---------- grids ------------------------------------------------------ */

  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .gallery__grid--mobile {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 120px;
    gap: 12px;
  }

  .gallery__grid--desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .gallery__grid--mobile {
      display: none;
    }
    .gallery__grid--desktop {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 90px;
      gap: 16px;
    }
  }

  @media (min-width: 1280px) {
    .gallery__grid--desktop {
      grid-auto-rows: 140px;
      gap: 22px;
    }
  }

  .gallery__cell {
    position: relative;
    overflow: hidden;
    min-height: 0;
  }

  .gallery__cell.is-tall {
    grid-row: span 2;
  }

  @media (min-width: 768px) {
    .gallery__grid--desktop .gallery__cell {
      grid-column: span var(--col);
      grid-row: span var(--row);
    }
  }

  .gallery__trigger {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
  }

  .gallery__photo {
    position: absolute;
    inset: 0;
  }

  .gallery__photo :global(img) {
    filter: brightness(0.78);
    transform: scale(1.001);
    transition:
      transform 600ms var(--ease-reveal),
      filter 600ms var(--ease-reveal);
    will-change: transform;
  }

  .gallery__trigger:hover .gallery__photo :global(img),
  .gallery__trigger:focus-visible .gallery__photo :global(img) {
    transform: scale(1.04);
    filter: brightness(1);
  }

  /* Touch has no hover — show the photographs at full brightness. */
  @media (hover: none) {
    .gallery__photo :global(img) {
      filter: brightness(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__photo :global(img) {
      transition: filter 200ms linear;
    }
    .gallery__trigger:hover .gallery__photo :global(img),
    .gallery__trigger:focus-visible .gallery__photo :global(img) {
      transform: none;
    }
  }
</style>
