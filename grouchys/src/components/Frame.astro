---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A photograph inside a fixed-size frame.
 *
 * Every image on the site goes through here so the cover behaviour, the
 * responsive srcset, the explicit dimensions and the empty state stay
 * identical everywhere. `src={null}` renders the frame with the photographer's
 * brief instead of borrowing another dish's picture.
 */
interface Props {
  src: ImageMetadata | null;
  alt: string;
  /** Rendered widths, used to build the srcset. */
  widths?: number[];
  sizes?: string;
  /** CSS object-position — how the crop holds its focal point. */
  position?: string;
  class?: string;
  /** Hero imagery must not be lazy-loaded. */
  priority?: boolean;
  /** Shown when there is no photograph yet. */
  brief?: string;
  /** Wraps the image so a mask/parallax transform has something to move. */
  mask?: boolean;
}

const {
  src,
  alt,
  widths = [420, 640, 860, 1120, 1400],
  sizes = '(max-width: 767px) 100vw, (max-width: 1279px) 60vw, 720px',
  position = '50% 50%',
  class: className = '',
  priority = false,
  brief,
  mask = false,
  ...rest
} = Astro.props;

/*
  `rest` carries the parent's `data-astro-cid-*` scope attribute. Forwarding it
  onto the root is what lets a section style its own frames — `.story__photo--2
  { height: 400px }` in Story.astro only matches if this element is inside that
  component's style scope. Without it every frame silently collapses to the
  image's intrinsic aspect ratio and the whole photographic rhythm goes.
*/

const available = src ? widths.filter((w) => w <= src.width) : [];
const finalWidths = available.length ? available : src ? [src.width] : [];
---

<div class:list={['frame', mask && 'frame-mask', className]} data-frame {...rest}>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={finalWidths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        style={`object-position:${position}`}
        data-frame-img
      />
    ) : (
      <div class="frame-empty">
        <span class="frame-empty__mark" aria-hidden="true" />
        {brief && <p class="frame-empty__brief">{brief}</p>}
      </div>
    )
  }
</div>

<style>
  .frame-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 32px;
    background: var(--color-black-4);
    border: 1px solid rgb(180 134 58 / 0.1);
  }

  .frame-empty__mark {
    width: 54px;
    height: 1px;
    background: rgb(180 134 58 / 0.45);
  }

  .frame-empty__brief {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    line-height: 2;
    text-transform: uppercase;
    color: rgb(184 178 167 / 0.34);
    text-align: center;
    max-width: 34ch;
  }
</style>
